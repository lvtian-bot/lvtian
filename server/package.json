{
  "name": "lvtian-server",
  "version": "0.3.4",
  "private": true,
  "description": "Lvtian Personal Assistant Independent Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc && node dist/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "token": "node dist/index.js --show-token",
    "upgrade-notify": "node scripts/upgrade-notify.mjs",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-acp": "0.2.2-rc.1",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.0.0"
  }
}
