{
  "name": "lvtian-server",
  "version": "0.3.4",
  "private": true,
  "description": "Lvtian Personal Assistant Independent Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc && node dist/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "token": "node dist/index.js --show-token",
    "upgrade-notify": "node scripts/upgrade-notify.mjs",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-acp": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "firebase-admin": "^14.5.1",
    "i18next": "^27.2.9",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@deepseek-ai/dsh-mcp-client": {
      "@modelcontextprotocol/client": "^2.4.0"
    },
    "@deepseek-ai/libreoffice-kit": {
      "fflate": "^0.8.3"
    },
    "undici@8.11.2": "^8.13.1"
  }
}
